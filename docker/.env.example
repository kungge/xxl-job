# XXL-JOB Admin production deployment
XXL_JOB_ADMIN_IMAGE=xxl-job-admin:3.5.0-snapshot-5f92bc10-parameters
XXL_JOB_ADMIN_BIND_IP=192.168.1.200
XXL_JOB_ADMIN_PORT=8101
XXL_JOB_DB_URL=jdbc:mysql://mysql:3306/xxl_job?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&serverTimezone=Asia/Shanghai
XXL_JOB_DB_USERNAME=xxl_job
XXL_JOB_DB_PASSWORD=change-me
XXL_JOB_LOG_PATH=/data/applogs
XXL_JOB_JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC

# Development docker-compose.yml only
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PATH=/path/to/mysql
XXL_JOB_ADMIN_CONTEXT_PATH=/
